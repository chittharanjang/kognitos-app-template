KOGNITOS_TOKEN=kgn_pat_...
KOGNITOS_ORG_ID=
KOGNITOS_WORKSPACE_ID=
KOGNITOS_BASE_URL=https://app.us-1.kognitos.com/api/v1
KOGNITOS_AUTOMATION_ID=
# SQL Query Generator (Chat + /query) — Kognitos automation id; leave empty to use default
KOGNITOS_SQL_QUERY_GENERATOR_ID=
NEXT_PUBLIC_KOGNITOS_URL=https://app.us-1.kognitos.com/organizations/{ORG_ID}/workspaces/{WS_ID}

# Supabase (for chat persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — required for Chat (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Microsoft Teams bot (Chat SDK) — only needed if deploying the Teams bot.
# Create an Azure Bot + app registration; see README "Microsoft Teams bot".
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
# Single-tenant bots only; leave empty for multi-tenant.
TEAMS_APP_TENANT_ID=
# Postgres connection string for bot state (subscriptions, locks, dedupe,
# per-thread history). Local: Supabase DB_URL from `supabase status`.
# Production: your Supabase connection-pooler URL.
POSTGRES_URL=

